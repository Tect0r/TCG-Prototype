{
  "name": "tcg-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone browser card-game prototype: deck builder, deterministic rules engine, authoritative 2-4 player online matches, and a local headless balance laboratory.",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tcg/web-client",
    "dev:server": "npm run dev --workspace @tcg/multiplayer-server",
    "dev:admin": "npm run dev --workspace @tcg/admin-client",
    "start:admin": "npm run start --workspace @tcg/admin-server",
    "demo:match": "npm run demo:match --workspace @tcg/rules-engine",
    "build": "npm run build --workspace @tcg/web-client && npm run build --workspace @tcg/admin-client",
    "preview": "npm run preview --workspace @tcg/web-client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:root",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "vite-node packages/help-content/src/cli.ts",
    "content:build": "vite-node packages/card-data/src/content/cli.ts --",
    "content:check": "vite-node packages/card-data/src/content/cli.ts -- --check",
    "audit:status": "vite-node scripts/audit-status.ts --",
    "audit:check": "vite-node scripts/audit-status.ts -- --check",
    "check:consistency": "vite-node scripts/check-consistency.ts --",
    "cards:new": "vite-node scripts/new-card.ts --",
    "report:triggers": "vite-node scripts/report-triggers.ts --",
    "verify": "npm run content:check && npm run typecheck && npm run lint && npm run format:check && npm run validate:content && npm run test && npm run build",
    "gen:placeholder-art": "node scripts/generate-placeholder-art.mjs",
    "simulate": "vite-node apps/simulator/src/cli.ts --",
    "bench": "vite-node apps/simulator/src/benchmark.ts --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.4"
  }
}
