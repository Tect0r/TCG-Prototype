{
  "name": "tcg-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone browser card-game prototype: deck builder now, rules engine / multiplayer / simulator later.",
  "engines": {
    "node": ">=20.11"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @tcg/web-client",
    "dev:server": "npm run dev --workspace @tcg/multiplayer-server",
    "demo:match": "npm run demo:match --workspace @tcg/rules-engine",
    "build": "npm run build --workspace @tcg/web-client",
    "preview": "npm run preview --workspace @tcg/web-client",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "gen:placeholder-art": "node scripts/generate-placeholder-art.mjs",
    "simulate": "vite-node apps/simulator/src/cli.ts --",
    "bench": "vite-node apps/simulator/src/benchmark.ts --"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^3.2.4"
  }
}
